{
  "manifest_version": 3,
  "name": "AirPlay Chromebook Caster",
  "version": "3.0.0",
  "description": "Experimental whole-screen and tab casting to legacy Apple TV through local Linux sender",
  "permissions": [
    "storage",
    "desktopCapture",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:8090/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chromebook AirPlay"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
