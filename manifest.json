{
  "manifest_version": 3,
  "name": "AirPlay Chromebook Caster",
  "version": "3.0.1",
  "description": "Experimental desktop and tab casting from ChromeOS to Apple TV",
  "permissions": [
    "storage",
    "desktopCapture"
  ],
  "host_permissions": [
    "http://127.0.0.1:8090/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Chromebook AirPlay Caster"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
